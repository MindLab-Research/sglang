# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# v4 增量镜像：在 v3（...-glm53-final-v3）之上叠加**目标 commit 的 sglang 代码**。
#
# 为什么「叠加」而不是从零重建：
#   v3 里有一批**构建期产物**不在 git 树里（实测 91 个：sglang.egg-info/*、
#   sglang/_version.py、jit_kernel/csrc/**.cuh …），另有 5 个被构建期改写的
#   pyproject*.toml。从零构建要复刻 mooncake 打包 + sgl-kernel 编译；
#   叠加只覆盖代码，这些产物原样保留（COPY 不会删除镜像里已有的文件）。
#   实测依据：v3 的 python/ 树 == commit 05243630 的 3454 个文件（3445 个 sha256 相同，
#   3 个是我们自己的 overlay 文件、5 个 pyproject），多的 91 个就是上面那些产物。
#
# ⚠️ 本文件与 rebuild-image.sh **都不做 docker push**。分发见 README §5（save/load）。
#
# 由 rebuild-image.sh 驱动（勿手工传参）：
#   docker build -f Dockerfile.rebuild \
#     --build-arg BASE_IMAGE=<v3> --build-arg SGLANG_REF=<commit> \
#     --build-arg WITH_P2P_AR=0 -t <local-tag> .
# 构建上下文要求：sglang-src/ = `git archive <ref>` 解出来的仓库树
# ---------------------------------------------------------------------------
ARG BASE_IMAGE=b200routeraca.azurecr.io/mindverse/sglang:v0.5.15.post1-cuda13-b200-glm53-final-v3
FROM ${BASE_IMAGE}

ARG SGLANG_REF=unknown
ARG WITH_P2P_AR=0
LABEL sglang.rebuild.base="${BASE_IMAGE}" \
      sglang.rebuild.ref="${SGLANG_REF}" \
      sglang.rebuild.p2p_ar="${WITH_P2P_AR}"

WORKDIR /sgl-workspace/sglang

# 只覆盖代码（同路径覆盖；镜像独有的产物不在上下文里，因此保留）
COPY sglang-src/ /sgl-workspace/sglang/

# ---------------------------------------------------------------------------
# 构建期自检（任一失败即让构建失败，避免产出"看起来好了"的镜像）
# ---------------------------------------------------------------------------
RUN set -eux; \
    python3 -c "import importlib.util as u; o=u.find_spec('sglang').origin; print('sglang ->', o); assert '/sgl-workspace/sglang/python/sglang/' in o, ('import 路径不在源码树，挂载/覆盖不会生效:', o)"; \
    python3 -m compileall -q /sgl-workspace/sglang/python/sglang; \
    test -f /sgl-workspace/sglang/python/sglang/_version.py; \
    test -f /sgl-workspace/sglang/python/sglang.egg-info/PKG-INFO; \
    test -f /usr/local/lib/python3.12/dist-packages/mooncake/engine.so; \
    md5sum /usr/local/lib/python3.12/dist-packages/mooncake/engine.so | grep -q '^8ea08f1ee95150fc218b23cb4d91978b '; \
    test "$(find /sgl-workspace/sglang/python -name '*.so' | wc -l)" = "0"; \
    if [ "${WITH_P2P_AR}" = "1" ]; then \
        cd /sgl-workspace/sglang/python/sglang/srt/distributed/device_communicators/p2p_ar; \
        bash build.sh; \
        mkdir -p /opt/p2p_ar && cp -v ./*.so /opt/p2p_ar/; \
        ls -l /opt/p2p_ar; \
    fi; \
    echo "rebuild self-check OK (ref=${SGLANG_REF}, p2p_ar=${WITH_P2P_AR})"
